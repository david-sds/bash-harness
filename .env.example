# Host directory where Ollama stores downloaded models (mounted at /root/.ollama).
# The directory must exist before `podman compose up` (podman won't create it).

# Original value: external HDD mounted at /media/HDD
# OLLAMA_MODELS_DIR=/media/HDD/ollama

# This machine (no HDD attached): local folder inside the repo
# OLLAMA_MODELS_DIR=./ollama
